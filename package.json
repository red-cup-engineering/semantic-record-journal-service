{
  "name": "@red-cup-engineering/semantic-record-journal-service",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Local addressed semantic records with strict SEAVT claims and independent support/refutation evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/semantic-record-journal-service.git"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.mjs",
    "./witness-journal-binding": "./src/witness-journal-binding.mjs"
  },
  "files": [
    "src",
    "scripts"
  ],
  "scripts": {
    "check": "node --check src/index.mjs && node --check src/witness-journal-binding.mjs && node --check scripts/admit-witness-journal-files.mjs && node --check scripts/start-journal-witness-provider.mjs",
    "verify": "npm run check && npm test",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/eavt-services-section": "workspace:*",
    "@red-cup-engineering/witness-journal-entry-service": "workspace:*",
    "@red-cup-engineering/witness-journal-log-service": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/witness-journal-document-service": "workspace:*"
  },
  "bin": {
    "admit-witness-journal-files": "scripts/admit-witness-journal-files.mjs",
    "start-journal-witness-provider": "scripts/start-journal-witness-provider.mjs"
  }
}
